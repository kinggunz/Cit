<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingHorizontal="10dp" android:paddingVertical="4dp">
    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/tvText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="15sp"
            android:textIsSelectable="true" />
        <LinearLayout android:id="@+id/btns"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView android:id="@+id/tvTime"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="end"
            android:textColor="#B8BAD6" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
